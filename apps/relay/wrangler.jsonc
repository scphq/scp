{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "scp-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "routes": [{ "pattern": "app.scp.dev", "custom_domain": true }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "scp-relay",
      "database_id": "ec5f912e-57ab-482f-b660-db46ba0b53a5",
      "migrations_dir": "migrations"
    }
  ],
  "send_email": [{ "name": "EMAIL" }],
  "vars": {
    "MAILER": "cloudflare",
    "MAIL_FROM": "login@scp.dev",
    "TURNSTILE_SITE_KEY": "0x4AAAAAAFaDQzRHNz0wV0wZ"
  },
  // Secrets: SESSION_SECRET, TURNSTILE_SECRET, optional RESEND_API_KEY (with MAILER=resend).
  "triggers": { "crons": ["17 3 * * *"] },
  "observability": { "enabled": true }
}

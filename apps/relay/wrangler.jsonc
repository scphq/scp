{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "scp-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // bundle the workspace packages from source, as the tests do
  "alias": { "@scp-dev/core": "../../packages/core/src/index.ts", "@scp-dev/hub": "../../packages/hub/src/index.ts" },
  "routes": [{ "pattern": "app.scp.dev", "custom_domain": true }],
  "kv_namespaces": [{ "binding": "OAUTH_KV" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "scp-relay",
      "database_id": "ec5f912e-57ab-482f-b660-db46ba0b53a5",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": { "bindings": [{ "name": "HUB", "class_name": "OrgHub" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["OrgHub"] }],
  "send_email": [{ "name": "EMAIL" }],
  "vars": {
    "RELAY_ORIGIN": "https://app.scp.dev",
    "MAILER": "cloudflare",
    "MAIL_FROM": "login@scp.dev",
    "TURNSTILE_SITE_KEY": "0x4AAAAAAFaDQzRHNz0wV0wZ"
  },
  // Secrets: SESSION_SECRET, TURNSTILE_SECRET, optional RESEND_API_KEY (with MAILER=resend), optional JUDGE_API_KEY or OPENROUTER_API_KEY.
  // Optional vars for the relay judge, set per deployment: JUDGE_MODEL (no default, the judge stays off without it), JUDGE_PROVIDER (default openrouter).
  "triggers": { "crons": ["17 3 * * *"] },
  "observability": { "enabled": true }
}

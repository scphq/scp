{
  "name": "scp",
  "private": true,
  "packageManager": "bun@1.4.2",
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "bun test",
    "build:packages": "bun run --filter './packages/*' build",
    "build": "bun run build:packages && bun run --filter @scp-dev/web build",
    "changeset": "changeset",
    "version-packages": "changeset version && bun install --lockfile-only",
    "release": "bun run build:packages && bun scripts/pin-workspace-deps.ts && changeset publish"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@changesets/cli": "^2.31.1",
    "@types/bun": "^1.4.3",
    "typescript": "^5.9.3"
  }
}

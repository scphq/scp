{
  "name": "@scp-dev/broker",
  "version": "0.0.0",
  "private": true,
  "description": "Swarm Communication Protocol local broker: a unix socket JSON-RPC daemon over the relay core, its client and the bridge to an account hub.",
  "license": "Apache-2.0",
  "homepage": "https://scp.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scphq/scp.git",
    "directory": "packages/broker"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "bun": "./src/testing.ts",
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "src", "!src/**/*.test.ts"],
  "scripts": {
    "build": "tsup src/index.ts src/testing.ts --format esm --dts --clean --external bun:sqlite --external bun:ffi",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "@scp-dev/core": "workspace:*",
    "@scp-dev/hub": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.5.1"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}

{
  "name": "@scp-dev/core",
  "version": "0.4.0",
  "description": "Swarm Communication Protocol core: wire types, framing, scopes, policy, judge and the relay core.",
  "license": "Apache-2.0",
  "homepage": "https://scp.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scphq/scp.git",
    "directory": "packages/core"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "typecheck": "tsc -p ."
  },
  "devDependencies": {
    "tsup": "^8.5.1"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}

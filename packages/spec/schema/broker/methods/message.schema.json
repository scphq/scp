{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "message",
  "title": "message",
  "$defs": {
    "Params": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "member": {
          "type": "boolean"
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": false
    },
    "Result": {
      "type": "object",
      "properties": {
        "message": {
          "anyOf": [
            {
              "$ref": "../types.schema.json#/$defs/Envelope"
            },
            {
              "$ref": "../types.schema.json#/$defs/ThreadMessage"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "message"
      ],
      "additionalProperties": false
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "spawn_end",
  "title": "spawn_end",
  "$defs": {
    "Params": {
      "type": "object",
      "properties": {
        "endpoint": {
          "type": "string"
        }
      },
      "required": [
        "endpoint"
      ],
      "additionalProperties": false
    },
    "Result": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "endpoint": {
              "$ref": "../types.schema.json#/$defs/EndpointView"
            },
            "held": {
              "type": "boolean"
            }
          },
          "required": [
            "endpoint",
            "held"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "endpoint": {
              "$ref": "../types.schema.json#/$defs/EndpointView"
            },
            "held": {
              "const": false
            },
            "runner": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "stop": {
                  "enum": [
                    "stopped",
                    "declined",
                    "failed",
                    "timeout",
                    "none"
                  ]
                },
                "code": {
                  "type": "integer"
                },
                "stderr": {
                  "type": "string"
                }
              },
              "required": [
                "name",
                "stop"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "held",
            "runner"
          ],
          "additionalProperties": false
        }
      ]
    }
  }
}

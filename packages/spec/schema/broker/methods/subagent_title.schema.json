{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "subagent_title",
  "title": "subagent_title",
  "$defs": {
    "Params": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "title"
      ],
      "additionalProperties": false
    },
    "Result": {
      "type": "object",
      "properties": {
        "changed": {
          "type": "boolean"
        }
      },
      "required": [
        "changed"
      ],
      "additionalProperties": false
    }
  }
}

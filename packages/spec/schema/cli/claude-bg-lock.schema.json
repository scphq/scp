{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "claude-bg-lock",
  "title": "The claude-bg run acting on one session",
  "description": "$SCP_DIR/claude-bg/<short id>.lock",
  "type": "object",
  "required": ["pid"],
  "properties": {
    "pid": { "description": "the process of the run holding it", "type": "integer", "minimum": 1 }
  },
  "additionalProperties": false
}

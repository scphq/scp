{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "credentials",
  "title": "Saved relay logins",
  "description": "$XDG_CONFIG_HOME/scp/credentials.json (else ~/.config/scp/credentials.json). Keys are relay origins as checkRelayUrl normalizes them",
  "type": "object",
  "additionalProperties": { "$ref": "#/$defs/Credential" },
  "$defs": {
    "Credential": {
      "type": "object",
      "required": ["token", "saved_at"],
      "properties": {
        "token": { "type": "string", "pattern": "\\S" },
        "kind": { "type": "string" },
        "org": { "type": "string" },
        "email": { "type": "string" },
        "label": { "type": "string" },
        "saved_at": { "type": "string", "format": "date-time" }
      }
    }
  }
}
